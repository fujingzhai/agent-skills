#!/usr/bin/env python3
"""bilibili-transcript 的稳定入口。

使用当前解释器运行（agent 调用哪个 python3 就用哪个），
不再假设本机存在 /opt/homebrew/bin/python3。
如果当前解释器缺少 yt_dlp 库，bili_fetch.py 会给出安装命令。
"""

import subprocess
import sys
from pathlib import Path

SCRIPT = Path(__file__).resolve().parent / "scripts" / "bili_fetch.py"

raise SystemExit(subprocess.run([sys.executable, str(SCRIPT), *sys.argv[1:]]).returncode)
